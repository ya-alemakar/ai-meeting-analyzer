{
  "name": "video-meeting-analyzer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "check": "node --check server.mjs && node --check process-video.mjs && node --check cloud-import.mjs && node --check api/meetings.js && node --check public/app.js"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "3.11.3"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/linux-x64": "4.1.0",
    "@ffprobe-installer/linux-x64": "5.2.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  }
}
